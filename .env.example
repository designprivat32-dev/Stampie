# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stampie?schema=public"

# --- App ------------------------------------------------------------------
# Public base URL for QR payloads, wallet asset URLs and the test-card landing page.
# Leave empty on Vercel — VERCEL_PROJECT_PRODUCTION_URL is used automatically.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage --------------------------------------------------------------
# "db"  asset bytes in PostgreSQL  (default; the only one that works serverless)
# "fs"  local filesystem           (local checkout only)
# "s3"  S3-compatible bucket
STORAGE_DRIVER="db"
STORAGE_FS_ROOT="./storage"

S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Mail -----------------------------------------------------------------
# "console" (dev) or "smtp"
MAIL_DRIVER="console"
MAIL_FROM="karten@stampie.de"

# --- Auth stub ------------------------------------------------------------
# Until the real auth layer lands, the session provider resolves this user id.
DEV_SESSION_USER_EMAIL="demo@stampie.de"

# Direct (non-pooled) connection, used for schema pushes and migrations.
# On Neon this is provided automatically; locally point it at the same server.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/stampie?schema=public"

# --- Google Wallet (optional; without these the save link is a non-working mock) -------
# Issuer id from https://pay.google.com/business/console  (free)
GOOGLE_ISSUER_ID=""
# Service account from Google Cloud with the Wallet API enabled.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# PEM private key. Newlines may be escaped as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- Apple Wallet (optional; requires Apple Developer Program) ------------------------
# Walkthrough: APPLE-WALLET.md — `npm run apple:cert -- csr` prints every step.
# Must match the certificate's UID field, otherwise Wallet refuses the pass.
APPLE_PASS_TYPE_ID="pass.de.stampie.stampcard"
# 10-character Team ID; must match the certificate's OU field.
APPLE_TEAM_ID=""
# Base64 of the Pass Type ID .p12 certificate. `npm run apple:cert -- env` prints it.
APPLE_PASS_CERTIFICATE=""
# Export password of that .p12. Empty is allowed and is what the helper script produces.
APPLE_PASS_CERTIFICATE_PASSWORD=""
# Only needed if Apple moves past WWDR G4 (valid until 2030). PEM or base64 DER.
APPLE_WWDR_CERTIFICATE=""
